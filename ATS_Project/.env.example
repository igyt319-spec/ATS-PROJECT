# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MySQL / Aiven Cloud / RDS)
DB_HOST=your_mysql_host
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=replace_with_your_database_password
DB_NAME=defaultdb
DB_SSL=true

# Authentication Secret (Minimum 32 random characters)
JWT_SECRET=replace_with_a_long_random_cryptographic_secret

# CORS & Domain Configuration
FRONTEND_URL=https://your-frontend-domain.com
ALLOWED_ORIGINS=https://ats-project-backend.onrender.com,http://localhost:5000,http://localhost:3000

# AI & Python Runtime Configuration
PYTHON_PATH=python

# Optional External AI API Key (Leave empty to use intelligent built-in fallback)
GEMINI_API_KEY=

# Safe Demo Seeding Flag (Set to true in non-production to seed demo accounts)
ALLOW_DEMO_SEED=false

